# Referee Environment Configuration
APP_URL=http://localhost:3000
DATABASE_URL=postgres://referee:referee@localhost:5432/referee

# PayPal Configuration (Strictly sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLATFORM_EMAIL=

# Kernel Cloud Browser
KERNEL_API_KEY=

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
GEMINI_API_KEY=

# Internal Security
INTERNAL_SWEEP_SECRET=

# Policy & Demo Settings
HUMAN_APPROVAL_THRESHOLD=300
DEMO_MODE=true
DEMO_TIME_SCALE=1440
