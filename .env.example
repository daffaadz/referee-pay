# Referee Environment Configuration
APP_URL=http://localhost:3000
# Database (Neon Postgres: pooled for app runtime, unpooled for migrations)
DATABASE_URL=postgres://neondb_owner:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgres://neondb_owner:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=verify-full

# PayPal Configuration (Strictly sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLATFORM_EMAIL=
PAYPAL_WEBHOOK_ID=

# Kernel Cloud Browser
KERNEL_API_KEY=

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
GEMINI_API_KEY=

# Internal Security
INTERNAL_SWEEP_SECRET=

# Policy & Demo Settings
HUMAN_APPROVAL_THRESHOLD=300
DEMO_MODE=true
DEMO_TIME_SCALE=1440
